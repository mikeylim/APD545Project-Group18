<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.FeedbackController" styleClass="main-container">

    <!-- Header -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="NEWNHAM NEXUS" styleClass="header-title"/>
                <Label text="Guest Feedback" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" >
        <VBox alignment="CENTER" spacing="30">
            <padding><Insets top="30" bottom="30" left="50" right="50"/></padding>

            <!-- Welcome message -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="We Value Your Feedback!" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Please share your experience with us" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Feedback form card -->
            <VBox styleClass="card" spacing="25" prefWidth="600" alignment="CENTER">
                <padding><Insets top="35" right="35" bottom="35" left="35"/></padding>

                <!-- Reservation lookup -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="Find Your Reservation" styleClass="form-label"/>
                    <HBox spacing="20" alignment="CENTER">
                        <RadioButton fx:id="lookupByConfirmation" text="Confirmation Number" selected="true">
                            <toggleGroup><ToggleGroup fx:id="lookupToggleGroup"/></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="lookupByPhone" text="Phone Number">
                            <toggleGroup><fx:reference source="lookupToggleGroup"/></toggleGroup>
                        </RadioButton>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER">
                        <TextField fx:id="lookupField" promptText="e.g., NNX-2026030901" prefWidth="250" styleClass="form-field"/>
                        <Button text="Lookup" styleClass="btn-primary" onAction="#lookupReservation"/>
                    </HBox>
                    <Label fx:id="lookupErrorLabel" text="" styleClass="error-label"/>
                </VBox>

                <!-- Reservation selection (shown when multiple reservations found) -->
                <VBox fx:id="reservationSelectionSection" spacing="10" style="-fx-background-color: #fff3cd; -fx-padding: 15; -fx-background-radius: 8;" visible="false" managed="false">
                    <Label text="Multiple stays found. Please select one:" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
                    <ComboBox fx:id="reservationComboBox" prefWidth="400" promptText="Select your stay..."/>
                    <Button text="Select This Stay" styleClass="btn-primary" onAction="#selectReservation"/>
                </VBox>

                <!-- Guest info display (shown after lookup) -->
                <VBox fx:id="guestInfoSection" spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 8;" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="3">
                            <Label text="Guest" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="guestNameLabel" text="John Smith" style="-fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="Room" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="roomLabel" text="Double #205"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="Stay" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <Label fx:id="stayDatesLabel" text="Mar 5-7, 2026"/>
                        </VBox>
                        <Label text="✓ Checked Out" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- Rating section -->
                <VBox fx:id="ratingSection" spacing="15" alignment="CENTER" visible="false" managed="false">
                    <Label text="How was your overall experience?" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <!-- Star rating -->
                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="star1" text="★" onAction="#setRating1" style="-fx-background-color: transparent; -fx-font-size: 40px; -fx-text-fill: #bdc3c7; -fx-cursor: hand;"/>
                        <Button fx:id="star2" text="★" onAction="#setRating2" style="-fx-background-color: transparent; -fx-font-size: 40px; -fx-text-fill: #bdc3c7; -fx-cursor: hand;"/>
                        <Button fx:id="star3" text="★" onAction="#setRating3" style="-fx-background-color: transparent; -fx-font-size: 40px; -fx-text-fill: #bdc3c7; -fx-cursor: hand;"/>
                        <Button fx:id="star4" text="★" onAction="#setRating4" style="-fx-background-color: transparent; -fx-font-size: 40px; -fx-text-fill: #bdc3c7; -fx-cursor: hand;"/>
                        <Button fx:id="star5" text="★" onAction="#setRating5" style="-fx-background-color: transparent; -fx-font-size: 40px; -fx-text-fill: #bdc3c7; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="ratingLabel" text="Click to rate" style="-fx-text-fill: #7f8c8d;"/>

                    <!-- Quick tags -->
                    <VBox spacing="10" alignment="CENTER">
                        <Label text="What did you like most? (optional)" style="-fx-font-weight: bold;"/>
                        <HBox spacing="10" alignment="CENTER">
                            <ToggleButton fx:id="tagCleanliness" text="Cleanliness" styleClass="btn-small btn-secondary"/>
                            <ToggleButton fx:id="tagComfort" text="Comfort" styleClass="btn-small btn-secondary"/>
                            <ToggleButton fx:id="tagService" text="Service" styleClass="btn-small btn-secondary"/>
                            <ToggleButton fx:id="tagLocation" text="Location" styleClass="btn-small btn-secondary"/>
                            <ToggleButton fx:id="tagValue" text="Value" styleClass="btn-small btn-secondary"/>
                        </HBox>
                    </VBox>

                    <!-- Comments -->
                    <VBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Additional Comments (optional)" styleClass="form-label"/>
                        <TextArea fx:id="commentsArea" promptText="Tell us more about your stay..." prefHeight="120" prefWidth="500" styleClass="form-field"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="charCountLabel" text="0/500 characters" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        </HBox>
                    </VBox>

                    <!-- Submit button -->
                    <Button text="Submit Feedback" styleClass="btn-success btn-large" onAction="#submitFeedback" prefWidth="250" prefHeight="50"/>
                </VBox>

                <!-- Error for not checked out -->
                <VBox fx:id="notEligibleSection" spacing="10" alignment="CENTER" visible="false" managed="false">
                    <Label text="⚠" style="-fx-font-size: 48px; -fx-text-fill: #f39c12;"/>
                    <Label text="Feedback Not Available Yet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #856404;"/>
                    <Label text="Feedback can only be submitted after check-out and balance settlement." wrapText="true" style="-fx-text-fill: #856404; -fx-text-alignment: center;" maxWidth="400"/>
                </VBox>
            </VBox>

            <!-- Back button -->
            <Button text="← Back to Main Menu" styleClass="btn-secondary" onAction="#backToLauncher"/>
        </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Thank you for staying with NewnhamNexus!" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </HBox>
    </bottom>
</BorderPane>
