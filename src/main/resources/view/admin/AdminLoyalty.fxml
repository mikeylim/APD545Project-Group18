<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.AdminController" styleClass="main-container" style="-fx-padding: 0;">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20; -fx-border-color: transparent transparent #34495e transparent;">
                <Label text="NEWNHAM NEXUS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="HOTEL" style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" style="-fx-padding: 15; -fx-background-color: #34495e;">
                <Label fx:id="userNameLabel" text="John Admin" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userRoleLabel" text="Administrator" style="-fx-font-size: 11px; -fx-text-fill: #3498db;"/>
            </VBox>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" styleClass="sidebar-item" onAction="#showDashboard" maxWidth="Infinity"/>
                <Button text="Reservations" styleClass="sidebar-item" onAction="#showReservations" maxWidth="Infinity"/>
                <Button text="Guests" styleClass="sidebar-item" onAction="#showGuests" maxWidth="Infinity"/>
                <Button text="Payments" styleClass="sidebar-item" onAction="#showPayments" maxWidth="Infinity"/>
                <Button text="Check-out" styleClass="sidebar-item" onAction="#showCheckout" maxWidth="Infinity"/>
                <Button text="Waitlist" styleClass="sidebar-item" onAction="#showWaitlist" maxWidth="Infinity"/>
                <Button text="Feedback" styleClass="sidebar-item" onAction="#showFeedbackManagement" maxWidth="Infinity"/>
                <Button text="Loyalty" styleClass="sidebar-item-active" onAction="#showLoyalty" maxWidth="Infinity"/>
                <Button text="Reports" styleClass="sidebar-item" onAction="#showReports" maxWidth="Infinity"/>
            </VBox>
            <Button text="Logout" styleClass="sidebar-item" style="-fx-background-color: #c0392b;" onAction="#handleLogout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <!-- Header -->
            <VBox>
                <Label text="Nexus Rewards - Loyalty Program" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Manage loyalty members, points, and redemptions" style="-fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Program stats -->
            <HBox spacing="20">
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS" style="-fx-background-color: #fff3cd;">
                    <Label text="Total Members" styleClass="stat-label"/>
                    <Label fx:id="loyaltyTotalMembersLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #856404;"/>
                    <Label text="Enrolled guests" style="-fx-font-size: 11px; -fx-text-fill: #856404;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Total Points Issued" styleClass="stat-label"/>
                    <Label fx:id="loyaltyTotalPointsLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #27ae60;"/>
                    <Label fx:id="loyaltyTotalValueLabel" text="\$0 value" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Average Points" styleClass="stat-label"/>
                    <Label fx:id="loyaltyAvgPointsLabel" text="0" styleClass="stat-number" style="-fx-text-fill: #3498db;"/>
                    <Label text="Per member" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Points Rates" styleClass="stat-label"/>
                    <Label fx:id="loyaltyEarningRateLabel" text="Earn: 10 pts/\$1" styleClass="stat-number" style="-fx-font-size: 18px; -fx-text-fill: #27ae60;"/>
                    <Label fx:id="loyaltyRedemptionRateLabel" text="Redeem: 100 pts = \$1" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;"/>
                </VBox>
            </HBox>

            <!-- Tabs for different views -->
            <TabPane VBox.vgrow="ALWAYS">
                <!-- Members Tab -->
                <Tab text="Members" closable="false">
                    <VBox spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="loyaltySearchField" promptText="Search by name, email, or loyalty #" prefWidth="300" styleClass="search-bar"/>
                            <Button text="Search" styleClass="btn-primary" onAction="#searchLoyaltyMembers"/>
                            <Button text="Clear" styleClass="btn-secondary" onAction="#clearLoyaltySearch"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Enroll New Member" styleClass="btn-success" onAction="#enrollMember"/>
                        </HBox>

                        <TableView fx:id="loyaltyMembersTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Loyalty #" prefWidth="120"/>
                                <TableColumn text="Name" prefWidth="150"/>
                                <TableColumn text="Email" prefWidth="200"/>
                                <TableColumn text="Phone" prefWidth="120"/>
                                <TableColumn text="Points" prefWidth="100"/>
                                <TableColumn text="Value" prefWidth="100"/>
                                <TableColumn text="Actions" prefWidth="120"/>
                            </columns>
                            <placeholder>
                                <Label text="No loyalty members found"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- Transactions Tab -->
                <Tab text="Transactions" closable="false">
                    <VBox spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <ComboBox promptText="Transaction Type" prefWidth="150">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Types"/>
                                        <String fx:value="Earned"/>
                                        <String fx:value="Redeemed"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <DatePicker promptText="From Date"/>
                            <DatePicker promptText="To Date"/>
                            <Button text="Filter" styleClass="btn-secondary"/>
                        </HBox>

                        <TableView VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn text="Date" prefWidth="100"/>
                                <TableColumn text="Loyalty #" prefWidth="100"/>
                                <TableColumn text="Member Name" prefWidth="150"/>
                                <TableColumn text="Type" prefWidth="80"/>
                                <TableColumn text="Points" prefWidth="80"/>
                                <TableColumn text="Reservation #" prefWidth="120"/>
                                <TableColumn text="Description" prefWidth="200"/>
                            </columns>
                            <placeholder>
                                <Label text="No transactions found"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- Settings Tab -->
                <Tab text="Program Settings" closable="false">
                    <VBox spacing="20">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                        <VBox styleClass="card" spacing="15">
                            <Label text="Points Earning Rate" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <GridPane hgap="20" vgap="15">
                                <Label text="Points earned per $1 spent:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <TextField fx:id="settingsPointsPerDollar" text="10" prefWidth="80" styleClass="form-field"/>
                                    <Label text="points" style="-fx-text-fill: #7f8c8d;"/>
                                </HBox>
                                <Label text="Example: Spend $100 → Earn 1,000 points" style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
                            </GridPane>
                        </VBox>

                        <VBox styleClass="card" spacing="15">
                            <Label text="Points Redemption Rate" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <GridPane hgap="20" vgap="15">
                                <Label text="Points needed for $1 discount:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <TextField fx:id="settingsPointsPerRedemption" text="100" prefWidth="80" styleClass="form-field"/>
                                    <Label text="points = $1.00" style="-fx-text-fill: #7f8c8d;"/>
                                </HBox>
                                <Label text="Example: Redeem 1,000 points → $10 discount" style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>

                                <Label text="Maximum points per redemption:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <TextField fx:id="settingsMaxRedemption" text="5000" prefWidth="80" styleClass="form-field"/>
                                    <Label text="points ($50 max)" style="-fx-text-fill: #7f8c8d;"/>
                                </HBox>

                                <Label text="Minimum points to redeem:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <TextField fx:id="settingsMinRedemption" text="100" prefWidth="80" styleClass="form-field"/>
                                    <Label text="points ($1 min)" style="-fx-text-fill: #7f8c8d;"/>
                                </HBox>
                            </GridPane>
                        </VBox>

                        <Button text="Save Settings" styleClass="btn-primary" onAction="#saveLoyaltySettings"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
