<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.AdminController" styleClass="main-container">

    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

            <!-- Logo and Title -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="NEWNHAM NEXUS HOTEL" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Staff Portal" style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Login Card -->
            <VBox styleClass="card" spacing="25" prefWidth="400" alignment="CENTER">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <Label text="Administrator Login" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Username -->
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="usernameField" styleClass="form-field" promptText="Enter your username" prefWidth="300" onAction="#handleLogin"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" styleClass="form-field" promptText="Enter your password" prefWidth="300" onAction="#handleLogin"/>
                </VBox>

                <!-- Remember me -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckbox" text="Remember me"/>
                </HBox>

                <!-- Error message -->
                <Label fx:id="loginErrorLabel" text="" styleClass="error-label" wrapText="true" maxWidth="300"/>

                <!-- Login button -->
                <Button text="Login" onAction="#handleLogin" prefWidth="300" prefHeight="50"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 15 40; -fx-background-insets: 0; -fx-background-radius: 5; -fx-font-weight: bold;"/>

                <!-- Forgot password -->
                <Hyperlink text="Forgot password?" onAction="#handleForgotPassword"/>
            </VBox>

            <!-- Role information -->
            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 8;">
                <Label text="Access Levels" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <HBox spacing="30" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="3">
                        <Label text="Admin" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                        <Label text="Up to 15% discount" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox alignment="CENTER" spacing="3">
                        <Label text="Manager" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                        <Label text="Up to 30% discount" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Back to launcher -->
            <Button text="← Back to Main Menu" onAction="#backToLauncher"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-insets: 0; -fx-background-radius: 5;"/>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="© 2026 NewnhamNexus - Staff Portal v1.0" style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;"/>
        </HBox>
    </bottom>
</BorderPane>
