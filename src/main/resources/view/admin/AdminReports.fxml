<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.AdminController" styleClass="main-container" style="-fx-padding: 0;">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20; -fx-border-color: transparent transparent #34495e transparent;">
                <Label text="NEWNHAM NEXUS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="HOTEL" style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" style="-fx-padding: 15; -fx-background-color: #34495e;">
                <Label fx:id="userNameLabel" text="John Admin" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userRoleLabel" text="Administrator" style="-fx-font-size: 11px; -fx-text-fill: #3498db;"/>
            </VBox>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" styleClass="sidebar-item" onAction="#showDashboard" maxWidth="Infinity"/>
                <Button text="Reservations" styleClass="sidebar-item" onAction="#showReservations" maxWidth="Infinity"/>
                <Button text="Guests" styleClass="sidebar-item" onAction="#showGuests" maxWidth="Infinity"/>
                <Button text="Payments" styleClass="sidebar-item" onAction="#showPayments" maxWidth="Infinity"/>
                <Button text="Check-out" styleClass="sidebar-item" onAction="#showCheckout" maxWidth="Infinity"/>
                <Button text="Waitlist" styleClass="sidebar-item" onAction="#showWaitlist" maxWidth="Infinity"/>
                <Button text="Feedback" styleClass="sidebar-item" onAction="#showFeedbackManagement" maxWidth="Infinity"/>
                <Button text="Loyalty" styleClass="sidebar-item" onAction="#showLoyalty" maxWidth="Infinity"/>
                <Button text="Reports" styleClass="sidebar-item sidebar-item-active" onAction="#showReports" maxWidth="Infinity"/>
            </VBox>
            <Button text="Logout" styleClass="sidebar-item" style="-fx-background-color: #c0392b;" onAction="#handleLogout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <!-- Header -->
            <VBox>
                <Label text="Reports &amp; Analytics" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Generate and export business reports" style="-fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Report tabs -->
            <TabPane VBox.vgrow="ALWAYS">

                <!-- Revenue Report Tab -->
                <Tab text="Revenue Report" closable="false">
                    <VBox spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <!-- Filters -->
                        <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
                            <Label text="Period:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="revenuePeriod" prefWidth="120">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Daily"/>
                                        <String fx:value="Weekly"/>
                                        <String fx:value="Monthly"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <DatePicker fx:id="revenueFromDate" promptText="From"/>
                            <DatePicker fx:id="revenueToDate" promptText="To"/>
                            <ComboBox fx:id="revenueRoomType" promptText="Room Type" prefWidth="130">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Rooms"/>
                                        <String fx:value="Single"/>
                                        <String fx:value="Double"/>
                                        <String fx:value="Deluxe"/>
                                        <String fx:value="Penthouse"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <Button text="Generate" styleClass="btn-primary" onAction="#generateRevenueReport"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Export CSV" styleClass="btn-secondary" onAction="#exportRevenueCSV"/>
                            <Button text="Export PDF" styleClass="btn-secondary" onAction="#exportRevenuePDF"/>
                        </HBox>

                        <!-- Revenue summary -->
                        <HBox spacing="20">
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Total Revenue" styleClass="stat-label"/>
                                <Label text="\$45,230" styleClass="stat-number" style="-fx-text-fill: #27ae60;"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Reservations" styleClass="stat-label"/>
                                <Label text="156" styleClass="stat-number"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Total Tax" styleClass="stat-label"/>
                                <Label text="\$5,220" styleClass="stat-number"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Total Discounts" styleClass="stat-label"/>
                                <Label text="\$2,100" styleClass="stat-number" style="-fx-text-fill: #e74c3c;"/>
                            </VBox>
                        </HBox>

                        <!-- Revenue table -->
                        <TableView fx:id="revenueTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Period" prefWidth="120"/>
                                <TableColumn text="Reservations" prefWidth="100"/>
                                <TableColumn text="Subtotal" prefWidth="100"/>
                                <TableColumn text="Tax" prefWidth="80"/>
                                <TableColumn text="Discounts" prefWidth="80"/>
                                <TableColumn text="Total" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="Select date range and click Generate to view report"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- Occupancy Report Tab -->
                <Tab text="Occupancy Report" closable="false">
                    <VBox spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <!-- Filters -->
                        <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
                            <Label text="View:" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="occupancyView" prefWidth="120">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Daily"/>
                                        <String fx:value="Weekly"/>
                                        <String fx:value="Monthly"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <DatePicker fx:id="occupancyFromDate" promptText="From"/>
                            <DatePicker fx:id="occupancyToDate" promptText="To"/>
                            <ComboBox fx:id="occupancyRoomType" promptText="Room Type" prefWidth="130">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Rooms"/>
                                        <String fx:value="Single"/>
                                        <String fx:value="Double"/>
                                        <String fx:value="Deluxe"/>
                                        <String fx:value="Penthouse"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <Button text="Generate" styleClass="btn-primary" onAction="#generateOccupancyReport"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Export CSV" styleClass="btn-secondary"/>
                            <Button text="Export PDF" styleClass="btn-secondary"/>
                        </HBox>

                        <!-- Occupancy summary -->
                        <HBox spacing="20">
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Avg Occupancy" styleClass="stat-label"/>
                                <Label text="78\%" styleClass="stat-number" style="-fx-text-fill: #27ae60;"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Total Rooms" styleClass="stat-label"/>
                                <Label text="50" styleClass="stat-number"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Peak Occupancy" styleClass="stat-label"/>
                                <Label text="96\%" styleClass="stat-number"/>
                            </VBox>
                            <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Lowest Occupancy" styleClass="stat-label"/>
                                <Label text="52\%" styleClass="stat-number"/>
                            </VBox>
                        </HBox>

                        <!-- Occupancy table -->
                        <TableView fx:id="occupancyTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Date" prefWidth="120"/>
                                <TableColumn text="Rooms Available" prefWidth="120"/>
                                <TableColumn text="Rooms Occupied" prefWidth="120"/>
                                <TableColumn text="Occupancy \%" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="Select date range and click Generate to view report"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- Activity Logs Tab -->
                <Tab text="Activity Logs" closable="false">
                    <VBox spacing="15">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                        <!-- Filters -->
                        <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
                            <TextField fx:id="logSearchField" promptText="Search logs..." prefWidth="200" styleClass="search-bar"/>
                            <ComboBox fx:id="logActionFilter" promptText="Action Type" prefWidth="150">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Actions"/>
                                        <String fx:value="Login"/>
                                        <String fx:value="Reservation Created"/>
                                        <String fx:value="Reservation Modified"/>
                                        <String fx:value="Reservation Cancelled"/>
                                        <String fx:value="Check-in"/>
                                        <String fx:value="Check-out"/>
                                        <String fx:value="Payment"/>
                                        <String fx:value="Refund"/>
                                        <String fx:value="Discount Applied"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <ComboBox fx:id="logActorFilter" promptText="Actor" prefWidth="130">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="All Users"/>
                                        <String fx:value="Admin"/>
                                        <String fx:value="Manager"/>
                                        <String fx:value="System"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                            <DatePicker fx:id="logFromDate" promptText="From"/>
                            <DatePicker fx:id="logToDate" promptText="To"/>
                            <Button text="Filter" styleClass="btn-primary"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Export CSV" styleClass="btn-secondary" onAction="#exportLogsCSV"/>
                            <Button text="Export TXT" styleClass="btn-secondary" onAction="#exportLogsTXT"/>
                        </HBox>

                        <!-- Logs table -->
                        <TableView fx:id="activityLogsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn text="Timestamp" prefWidth="150"/>
                                <TableColumn text="Actor" prefWidth="100"/>
                                <TableColumn text="Action" prefWidth="150"/>
                                <TableColumn text="Entity Type" prefWidth="100"/>
                                <TableColumn text="Entity ID" prefWidth="120"/>
                                <TableColumn text="Message" prefWidth="300"/>
                            </columns>
                            <placeholder>
                                <Label text="No activity logs found"/>
                            </placeholder>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="10">
                            <Button text="← Previous" styleClass="btn-small btn-secondary"/>
                            <Label text="Page 1 of 25"/>
                            <Button text="Next →" styleClass="btn-small btn-secondary"/>
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
