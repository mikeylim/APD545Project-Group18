<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.AdminController" styleClass="main-container" style="-fx-padding: 0;">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20; -fx-border-color: transparent transparent #34495e transparent;">
                <Label text="NEWNHAM NEXUS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="HOTEL" style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" style="-fx-padding: 15; -fx-background-color: #34495e;">
                <Label fx:id="userNameLabel" text="John Admin" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userRoleLabel" text="Administrator" style="-fx-font-size: 11px; -fx-text-fill: #3498db;"/>
            </VBox>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" styleClass="sidebar-item" onAction="#showDashboard" maxWidth="Infinity"/>
                <Button text="Reservations" styleClass="sidebar-item" onAction="#showReservations" maxWidth="Infinity"/>
                <Button text="Guests" styleClass="sidebar-item sidebar-item-active" onAction="#showGuests" maxWidth="Infinity"/>
                <Button text="Payments" styleClass="sidebar-item" onAction="#showPayments" maxWidth="Infinity"/>
                <Button text="Check-out" styleClass="sidebar-item" onAction="#showCheckout" maxWidth="Infinity"/>
                <Button text="Waitlist" styleClass="sidebar-item" onAction="#showWaitlist" maxWidth="Infinity"/>
                <Button text="Feedback" styleClass="sidebar-item" onAction="#showFeedbackManagement" maxWidth="Infinity"/>
                <Button text="Loyalty" styleClass="sidebar-item" onAction="#showLoyalty" maxWidth="Infinity"/>
                <Button text="Reports" styleClass="sidebar-item" onAction="#showReports" maxWidth="Infinity"/>
            </VBox>
            <Button text="Logout" styleClass="sidebar-item" style="-fx-background-color: #c0392b;" onAction="#handleLogout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <!-- Header -->
            <VBox>
                <Label text="Guest Management" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Search and manage guest information" style="-fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Search -->
            <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="guestSearchField" promptText="Search by name, email, or phone" prefWidth="350" styleClass="search-bar"/>
                <ComboBox fx:id="loyaltyFilter" promptText="Loyalty Status" prefWidth="150">
                    <items>
                        <javafx.collections.FXCollections fx:factory="observableArrayList">
                            <String fx:value="All Guests"/>
                            <String fx:value="Loyalty Members"/>
                            <String fx:value="Non-Members"/>
                        </javafx.collections.FXCollections>
                    </items>
                </ComboBox>
                <Button text="Search" styleClass="btn-primary" onAction="#searchGuests"/>
                <Button text="Clear" styleClass="btn-secondary" onAction="#clearGuestSearch"/>
            </HBox>

            <!-- Guests table -->
            <VBox styleClass="card" spacing="15" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Guests" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="guestCountLabel" text="Showing 50 guests" style="-fx-text-fill: #7f8c8d;"/>
                </HBox>

                <TableView fx:id="guestsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Guest ID" prefWidth="80"/>
                        <TableColumn text="Name" prefWidth="150"/>
                        <TableColumn text="Email" prefWidth="180"/>
                        <TableColumn text="Phone" prefWidth="130"/>
                        <TableColumn text="Total Stays" prefWidth="80"/>
                        <TableColumn text="Loyalty #" prefWidth="100"/>
                        <TableColumn text="Points" prefWidth="80"/>
                        <TableColumn text="Last Stay" prefWidth="100"/>
                        <TableColumn text="Actions" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No guests found"/>
                    </placeholder>
                </TableView>

                <!-- Pagination -->
                <HBox alignment="CENTER" spacing="10">
                    <Button text="← Previous" styleClass="btn-small btn-secondary"/>
                    <Label text="Page 1 of 10"/>
                    <Button text="Next →" styleClass="btn-small btn-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Guest detail panel -->
    <right>
        <VBox styleClass="card" spacing="15" prefWidth="320" style="-fx-background-color: #f8f9fa;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="Guest Profile" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                <Button text="×" styleClass="btn-small" style="-fx-background-color: transparent;"/>
            </HBox>

            <Separator/>

            <VBox alignment="CENTER" spacing="5">
                <Label text="JS" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #3498db; -fx-background-radius: 30; -fx-padding: 15 20;"/>
                <Label text="John Smith" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Loyalty Member" style="-fx-text-fill: #f39c12; -fx-font-size: 12px;"/>
            </VBox>

            <Separator/>

            <GridPane hgap="10" vgap="8">
                <Label text="Email:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="john.smith@email.com" GridPane.columnIndex="1" GridPane.rowIndex="0" wrapText="true"/>

                <Label text="Phone:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="+1 (416) 555-0123" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Address:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="123 Main St, North York" GridPane.columnIndex="1" GridPane.rowIndex="2" wrapText="true"/>

                <Label text="Loyalty #:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="MR-123456" style="-fx-text-fill: #f39c12;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Points:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label text="2,500" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Total Stays:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label text="8" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Member Since:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <Label text="Jan 2024" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            </GridPane>

            <Separator/>

            <Label text="Reservation History" style="-fx-font-weight: bold;"/>
            <VBox spacing="8">
                <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 8; -fx-background-radius: 4;">
                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                        <Label text="NNX-2026030901" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="Mar 15-17, 2026" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <Label text="Confirmed" style="-fx-text-fill: #27ae60; -fx-font-size: 11px;"/>
                </HBox>
                <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 8; -fx-background-radius: 4;">
                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                        <Label text="NNX-2025120505" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Label text="Dec 5-8, 2025" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                    </VBox>
                    <Label text="Completed" style="-fx-text-fill: #3498db; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <Separator/>

            <VBox spacing="10">
                <Button text="View All Reservations" styleClass="btn-secondary" maxWidth="Infinity"/>
                <Button text="Edit Guest Info" styleClass="btn-primary" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </right>
</BorderPane>
