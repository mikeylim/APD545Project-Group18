<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.AdminController" styleClass="main-container" style="-fx-padding: 0;">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20; -fx-border-color: transparent transparent #34495e transparent;">
                <Label text="NEWNHAM NEXUS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="HOTEL" style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" style="-fx-padding: 15; -fx-background-color: #34495e;">
                <Label fx:id="userNameLabel" text="John Admin" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userRoleLabel" text="Administrator" style="-fx-font-size: 11px; -fx-text-fill: #3498db;"/>
            </VBox>
            <VBox spacing="0" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" styleClass="sidebar-item" onAction="#showDashboard" maxWidth="Infinity"/>
                <Button text="Reservations" styleClass="sidebar-item" onAction="#showReservations" maxWidth="Infinity"/>
                <Button text="Guests" styleClass="sidebar-item" onAction="#showGuests" maxWidth="Infinity"/>
                <Button text="Payments" styleClass="sidebar-item" onAction="#showPayments" maxWidth="Infinity"/>
                <Button text="Check-out" styleClass="sidebar-item" onAction="#showCheckout" maxWidth="Infinity"/>
                <Button text="Waitlist" styleClass="sidebar-item" onAction="#showWaitlist" maxWidth="Infinity"/>
                <Button text="Feedback" styleClass="sidebar-item sidebar-item-active" onAction="#showFeedbackManagement" maxWidth="Infinity"/>
                <Button text="Loyalty" styleClass="sidebar-item" onAction="#showLoyalty" maxWidth="Infinity"/>
                <Button text="Reports" styleClass="sidebar-item" onAction="#showReports" maxWidth="Infinity"/>
            </VBox>
            <Button text="Logout" styleClass="sidebar-item" style="-fx-background-color: #c0392b;" onAction="#handleLogout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Feedback Management" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Review and analyze guest feedback" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
                <Button text="Export Summary" styleClass="btn-primary" onAction="#exportFeedback"/>
            </HBox>

            <!-- Stats cards -->
            <HBox spacing="20">
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Average Rating" styleClass="stat-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="4.2" styleClass="stat-number" style="-fx-text-fill: #f39c12;"/>
                        <Label text="/ 5" style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d;"/>
                    </HBox>
                    <Label text="Based on 156 reviews" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="5 Star" styleClass="stat-label"/>
                    <Label text="78" styleClass="stat-number" style="-fx-text-fill: #27ae60;"/>
                    <Label text="50\%" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="4 Star" styleClass="stat-label"/>
                    <Label text="45" styleClass="stat-number" style="-fx-text-fill: #3498db;"/>
                    <Label text="29\%" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="3 Star" styleClass="stat-label"/>
                    <Label text="20" styleClass="stat-number" style="-fx-text-fill: #f39c12;"/>
                    <Label text="13\%" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="1-2 Star" styleClass="stat-label"/>
                    <Label text="13" styleClass="stat-number" style="-fx-text-fill: #e74c3c;"/>
                    <Label text="8\%" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>

            <!-- Common issues tags -->
            <HBox styleClass="card" spacing="10" alignment="CENTER_LEFT">
                <Label text="Common Tags:" style="-fx-font-weight: bold;"/>
                <Label text="Cleanliness (45)" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 15;"/>
                <Label text="Service (38)" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 15;"/>
                <Label text="Comfort (32)" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 15;"/>
                <Label text="Noise (12)" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 15;"/>
                <Label text="WiFi (8)" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 15;"/>
            </HBox>

            <!-- Filters -->
            <HBox styleClass="card" spacing="15" alignment="CENTER_LEFT">
                <ComboBox fx:id="ratingFilter" promptText="Rating" prefWidth="120">
                    <items>
                        <javafx.collections.FXCollections fx:factory="observableArrayList">
                            <String fx:value="All Ratings"/>
                            <String fx:value="5 Stars"/>
                            <String fx:value="4 Stars"/>
                            <String fx:value="3 Stars"/>
                            <String fx:value="2 Stars"/>
                            <String fx:value="1 Star"/>
                        </javafx.collections.FXCollections>
                    </items>
                </ComboBox>
                <DatePicker fx:id="feedbackFromDate" promptText="From Date"/>
                <DatePicker fx:id="feedbackToDate" promptText="To Date"/>
                <ComboBox fx:id="sentimentFilter" promptText="Sentiment" prefWidth="120">
                    <items>
                        <javafx.collections.FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Positive"/>
                            <String fx:value="Neutral"/>
                            <String fx:value="Negative"/>
                        </javafx.collections.FXCollections>
                    </items>
                </ComboBox>
                <TextField fx:id="feedbackGuestSearch" promptText="Search by guest" prefWidth="150"/>
                <Button text="Apply" styleClass="btn-primary"/>
                <Button text="Clear" styleClass="btn-secondary"/>
            </HBox>

            <!-- Feedback table -->
            <VBox styleClass="card" spacing="15" VBox.vgrow="ALWAYS">
                <TableView fx:id="feedbackTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Date" prefWidth="100"/>
                        <TableColumn text="Conf. #" prefWidth="120"/>
                        <TableColumn text="Guest" prefWidth="130"/>
                        <TableColumn text="Rating" prefWidth="80"/>
                        <TableColumn text="Comment" prefWidth="300"/>
                        <TableColumn text="Sentiment" prefWidth="90"/>
                        <TableColumn text="Actions" prefWidth="80"/>
                    </columns>
                    <placeholder>
                        <Label text="No feedback found"/>
                    </placeholder>
                </TableView>

                <!-- Pagination -->
                <HBox alignment="CENTER" spacing="10">
                    <Button text="← Previous" styleClass="btn-small btn-secondary"/>
                    <Label text="Page 1 of 8"/>
                    <Button text="Next →" styleClass="btn-small btn-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Feedback detail panel -->
    <right>
        <VBox styleClass="card" spacing="15" prefWidth="320" style="-fx-background-color: #f8f9fa;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="Feedback Details" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                <Button text="×" styleClass="btn-small" style="-fx-background-color: transparent;"/>
            </HBox>

            <Separator/>

            <!-- Rating display -->
            <VBox alignment="CENTER" spacing="5">
                <HBox alignment="CENTER" spacing="5">
                    <Label text="★" style="-fx-font-size: 24px; -fx-text-fill: #f39c12;"/>
                    <Label text="★" style="-fx-font-size: 24px; -fx-text-fill: #f39c12;"/>
                    <Label text="★" style="-fx-font-size: 24px; -fx-text-fill: #f39c12;"/>
                    <Label text="★" style="-fx-font-size: 24px; -fx-text-fill: #f39c12;"/>
                    <Label text="★" style="-fx-font-size: 24px; -fx-text-fill: #bdc3c7;"/>
                </HBox>
                <Label text="4 out of 5 stars" style="-fx-text-fill: #7f8c8d;"/>
            </VBox>

            <Separator/>

            <GridPane hgap="10" vgap="8">
                <Label text="Guest:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="John Smith" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Conf #:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="NNX-2026030501" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Stay:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="Mar 5-7, 2026" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Room:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="Double #205" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Submitted:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Label text="Mar 7, 2026" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Sentiment:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label text="Positive" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <Separator/>

            <VBox spacing="8">
                <Label text="Comment" style="-fx-font-weight: bold;"/>
                <TextArea text="Great stay overall! The room was clean and comfortable. Staff was very helpful during check-in. Only minor issue was the WiFi being a bit slow in the evening. Would definitely recommend and come back!" wrapText="true" prefHeight="120" editable="false" style="-fx-background-color: white;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Tags" style="-fx-font-weight: bold;"/>
                <HBox spacing="5">
                    <Label text="Cleanliness" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 10; -fx-font-size: 11px;"/>
                    <Label text="Service" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 10; -fx-font-size: 11px;"/>
                    <Label text="WiFi" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 10; -fx-font-size: 11px;"/>
                </HBox>
            </VBox>
        </VBox>
    </right>
</BorderPane>
