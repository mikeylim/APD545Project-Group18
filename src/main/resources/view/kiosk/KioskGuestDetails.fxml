<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.KioskController" styleClass="main-container">

    <!-- Header -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <Button text="← Main Menu" styleClass="btn-secondary" onAction="#backToMainMenu"/>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="NEWNHAM NEXUS" styleClass="header-title"/>
                <Label text="Step 5 of 6: Guest Information" styleClass="header-subtitle"/>
            </VBox>
            <Button text="Rules &amp; Regulations" styleClass="rules-button" onAction="#showRules"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding><Insets top="30" bottom="0" left="50" right="50"/></padding>

            <!-- Progress indicator (fixed position) -->
            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="✓" styleClass="kiosk-step-indicator kiosk-step-indicator-completed"/>
                    <Label text="Guests" styleClass="kiosk-step-label-completed"/>
                </VBox>
                <Label text="—" styleClass="kiosk-step-connector-completed"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="✓" styleClass="kiosk-step-indicator kiosk-step-indicator-completed"/>
                    <Label text="Dates" styleClass="kiosk-step-label-completed"/>
                </VBox>
                <Label text="—" styleClass="kiosk-step-connector-completed"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="✓" styleClass="kiosk-step-indicator kiosk-step-indicator-completed"/>
                    <Label text="Room" styleClass="kiosk-step-label-completed"/>
                </VBox>
                <Label text="—" styleClass="kiosk-step-connector-completed"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="✓" styleClass="kiosk-step-indicator kiosk-step-indicator-completed"/>
                    <Label text="Add-ons" styleClass="kiosk-step-label-completed"/>
                </VBox>
                <Label text="—" styleClass="kiosk-step-connector-completed"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="5" styleClass="kiosk-step-indicator kiosk-step-indicator-active"/>
                    <Label text="Details" styleClass="kiosk-step-label-active"/>
                </VBox>
                <Label text="—" styleClass="kiosk-step-connector"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="6" styleClass="kiosk-step-indicator"/>
                    <Label text="Confirm" styleClass="kiosk-step-label"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER" spacing="20">
                    <padding><Insets top="10" bottom="20" left="0" right="0"/></padding>

                    <!-- Main form -->
                <VBox styleClass="card" spacing="25" prefWidth="700">
                    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

                    <VBox spacing="5">
                        <Label text="Enter Your Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label text="Please fill in the required information below" style="-fx-text-fill: #7f8c8d;"/>
                        <HBox spacing="5">
                            <Label text="*" styleClass="required-indicator"/>
                            <Label text="indicates required field" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                        </HBox>
                    </VBox>

                    <GridPane hgap="20" vgap="15">
                        <!-- First Name -->
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="5">
                            <HBox spacing="3">
                                <Label text="First Name" styleClass="form-label"/>
                                <Label text="*" styleClass="required-indicator"/>
                            </HBox>
                            <TextField fx:id="firstNameField" styleClass="form-field" promptText="Enter first name" prefWidth="280"/>
                            <Label fx:id="firstNameError" text="" styleClass="error-label"/>
                        </VBox>

                        <!-- Last Name -->
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="5">
                            <HBox spacing="3">
                                <Label text="Last Name" styleClass="form-label"/>
                                <Label text="*" styleClass="required-indicator"/>
                            </HBox>
                            <TextField fx:id="lastNameField" styleClass="form-field" promptText="Enter last name" prefWidth="280"/>
                            <Label fx:id="lastNameError" text="" styleClass="error-label"/>
                        </VBox>

                        <!-- Email -->
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="5">
                            <HBox spacing="3">
                                <Label text="Email Address" styleClass="form-label"/>
                                <Label text="*" styleClass="required-indicator"/>
                            </HBox>
                            <TextField fx:id="emailField" styleClass="form-field" promptText="example@email.com" prefWidth="280"/>
                            <Label fx:id="emailError" text="" styleClass="error-label"/>
                        </VBox>

                        <!-- Phone -->
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5">
                            <HBox spacing="3">
                                <Label text="Phone Number" styleClass="form-label"/>
                                <Label text="*" styleClass="required-indicator"/>
                            </HBox>
                            <TextField fx:id="phoneField" styleClass="form-field" promptText="+1 (XXX) XXX-XXXX" prefWidth="280"/>
                            <Label fx:id="phoneError" text="" styleClass="error-label"/>
                        </VBox>

                        <!-- Address -->
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" spacing="5">
                            <Label text="Street Address" styleClass="form-label"/>
                            <TextField fx:id="addressField" styleClass="form-field" promptText="Enter street address"/>
                        </VBox>

                        <!-- City -->
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="3" spacing="5">
                            <Label text="City" styleClass="form-label"/>
                            <TextField fx:id="cityField" styleClass="form-field" promptText="City" prefWidth="280"/>
                        </VBox>

                        <!-- Country -->
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="5">
                            <Label text="Country" styleClass="form-label"/>
                            <ComboBox fx:id="countryCombo" styleClass="form-field" promptText="Select country" prefWidth="280">
                                <items>
                                    <javafx.collections.FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Canada"/>
                                        <String fx:value="United States"/>
                                        <String fx:value="United Kingdom"/>
                                        <String fx:value="Australia"/>
                                        <String fx:value="Other"/>
                                    </javafx.collections.FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <!-- Special Requests -->
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" spacing="5">
                            <Label text="Special Requests (optional)" styleClass="form-label"/>
                            <TextArea fx:id="specialRequestsArea" styleClass="form-field" promptText="Any special requests or notes..." prefHeight="80"/>
                            <Label text="e.g., early check-in, accessibility needs, room preferences" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        </VBox>
                    </GridPane>

                    <!-- Loyalty Program -->
                    <VBox spacing="10" style="-fx-background-color: #fff3cd; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #ffc107; -fx-border-radius: 8;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <CheckBox fx:id="loyaltyCheckbox"/>
                            <VBox spacing="3">
                                <Label text="Join our Nexus Rewards Loyalty Program" style="-fx-font-weight: bold; -fx-text-fill: #856404;"/>
                                <Label text="Earn points on every stay and redeem for discounts!" style="-fx-font-size: 12px; -fx-text-fill: #856404;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Terms and Conditions -->
                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <CheckBox fx:id="termsCheckbox"/>
                            <HBox spacing="3">
                                <Label text="I agree to the" style="-fx-font-size: 13px;"/>
                                <Hyperlink text="Terms and Conditions" style="-fx-font-size: 13px;"/>
                                <Label text="and" style="-fx-font-size: 13px;"/>
                                <Hyperlink text="Privacy Policy" style="-fx-font-size: 13px;"/>
                                <Label text="*" styleClass="required-indicator"/>
                            </HBox>
                        </HBox>
                        <Label fx:id="termsError" text="" styleClass="error-label"/>
                    </VBox>
                </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Navigation -->
    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Button text="← Back" styleClass="btn-secondary" onAction="#backToAddOns" prefWidth="150" prefHeight="50"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Review Booking →" styleClass="btn-primary" onAction="#goToSummary" prefWidth="180" prefHeight="50"/>
        </HBox>
    </bottom>
</BorderPane>
