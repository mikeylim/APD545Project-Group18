<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.hotel.controller.KioskController" styleClass="main-container">

    <!-- Header with Rules button always visible -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <Button text="← Main Menu" styleClass="btn-secondary" onAction="#backToMainMenu"/>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="NEWNHAM NEXUS" styleClass="header-title"/>
                <Label text="Self-Service Booking Kiosk" styleClass="header-subtitle"/>
            </VBox>
            <Button text="Rules &amp; Regulations" styleClass="rules-button" onAction="#showRules"/>
        </HBox>
    </top>

    <!-- Main welcome content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox alignment="CENTER" spacing="30">
                <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

            <!-- Welcome Message -->
            <VBox alignment="CENTER" spacing="15">
                <Label text="Welcome to NewnhamNexus!" styleClass="kiosk-welcome-title"/>
                <Label text="Experience North York's finest hospitality" styleClass="kiosk-welcome-subtitle"/>
            </VBox>

            <!-- Hotel image -->
            <VBox styleClass="card" alignment="CENTER" prefWidth="600" spacing="10">
                <ImageView fitWidth="550" fitHeight="300" preserveRatio="true">
                    <Image url="@/images/hotel-main.jpg"/>
                </ImageView>
                <Label text="Experience North York's finest hospitality" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Instructions -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Ready to book your stay?" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Follow the simple steps to reserve your room" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Start button -->
            <Button text="Begin Booking" styleClass="btn-primary btn-large" onAction="#startBooking" prefWidth="300" prefHeight="60" style="-fx-font-size: 20px;"/>

            <!-- Quick info -->
            <HBox alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Step 1" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label text="Guest Info" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
                <Label text="→" style="-fx-font-size: 20px; -fx-text-fill: #bdc3c7;"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Step 2" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label text="Select Dates" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
                <Label text="→" style="-fx-font-size: 20px; -fx-text-fill: #bdc3c7;"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Step 3" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label text="Choose Room" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
                <Label text="→" style="-fx-font-size: 20px; -fx-text-fill: #bdc3c7;"/>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Step 4" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label text="Confirm" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox styleClass="card" alignment="CENTER" spacing="30">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Need assistance? Please contact our front desk staff." style="-fx-text-fill: #7f8c8d;"/>
        </HBox>
    </bottom>
</BorderPane>
